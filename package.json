{
  "name": "pos-project",
  "version": "1.0.1",
  "description": "POS Project - Lightweight Offline Point-of-Sale System",
  "main": "electron/main.js",
  "author": "Kishore",
  "scripts": {
    "start": "electron .",
    "build:client": "npm --prefix client run build",
    "build:exe": "npm run build:client && electron-builder --win nsis",
    "dist": "npm run build:exe"
  },
  "build": {
    "appId": "com.posproject.app",
    "productName": "POS Project",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "**/*",
      "!client/src/**/*",
      "!client/public/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POS Project",
      "artifactName": "POS-Project-Setup.${ext}"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron@34.5.8": true
  }
}
